USE formula1;

CREATE TABLE drivers (
	  driver_id INT PRIMARY KEY NOT NULL,
    driver_name VARCHAR(100),
    nationality VARCHAR(25),
    team_id INT,
    date_of_birth DATE,
    FOREIGN KEY (team_id) REFERENCES racing_teams(team_id)
);

CREATE TABLE racing_teams (
  	team_id INT PRIMARY KEY NOT NULL,
    team_name VARCHAR(200),
    base_country VARCHAR(25)
);

CREATE TABLE circuits (
  	circuit_id INT PRIMARY KEY NOT NULL,
    circuit_name VARCHAR(200),
    circuit_location VARCHAR(50)
);

CREATE TABLE races (
  	race_id INT PRIMARY AUTO_INCREMENT KEY NOT NULL,
    race_name VARCHAR(200),
    season YEAR,
    circuit_id INT,
    race_date DATE,
    FOREIGN KEY (circuit_id) REFERENCES circuits(circuit_id)
);

CREATE TABLE results (
  	result_id INT PRIMARY KEY NOT NULL,
    race_id INT,
    driver_id INT,
    position INT,
    pts DECIMAL,
    laps_completed INT,
    lap_times VARCHAR(10),
    stat varchar(8),
    FOREIGN KEY (race_id) REFERENCES races(race_id),
  	FOREIGN KEY (driver_id) REFERENCES drivers(driver_id)
);

CREATE TABLE car_specs (
  	car_id INT PRIMARY KEY NOT NULL,
    team_id INT,
    chassis VARCHAR(25),
    power_unit VARCHAR(100),
    FOREIGN KEY (team_id) REFERENCES racing_teams(team_id)
);

CREATE TABLE fastest_laps (
  	fastest_lap_id INT AUTO_INCREMENT PRIMARY KEY NOT NULL,
    race_id INT,
    driver_id INT,
    lap_time VARCHAR(8),
    FOREIGN KEY (race_id) REFERENCES races(race_id),
    FOREIGN KEY (driver_id) REFERENCES drivers(driver_id)
);

CREATE TABLE pitstops (
  	pitstop_id INT AUTO_INCREMENT PRIMARY KEY NOT NULL,
    race_id INT,
    driver_id INT,
    team_id INT,
    lap_number INT,
    pit_duration decimal(2,2),
    FOREIGN KEY (race_id) REFERENCES races(race_id),
    FOREIGN KEY (driver_id) REFERENCES drivers(driver_id),
    FOREIGN KEY (team_id) REFERENCES racing_teams(team_id)
);
